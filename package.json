{
  "name": "job-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack job application tracker (React + Express + PostgreSQL)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "test": "npm test --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=22.18"
  }
}

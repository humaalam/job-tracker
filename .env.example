# Copy this file to `.env` and adjust the values.
# `.env` is ignored by git — never commit real secrets.

# --- Local PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=jobtracker
POSTGRES_DB=jobtracker
POSTGRES_PORT=5432
# Adminer (database web UI) will be at http://localhost:ADMINER_PORT
ADMINER_PORT=8080

# --- Server ---
NODE_ENV=development
PORT=4000
# Connection string Prisma uses: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://jobtracker:jobtracker@localhost:5432/jobtracker?schema=public
# Separate database for automated tests (so tests never wipe your real data)
TEST_DATABASE_URL=postgresql://jobtracker:jobtracker@localhost:5432/jobtracker_test?schema=public
# Secret used to sign login tokens — use a long random string
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# The frontend's URL (allowed by CORS)
CLIENT_ORIGIN=http://localhost:5173
